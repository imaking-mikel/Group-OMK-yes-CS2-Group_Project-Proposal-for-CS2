Plushy Shop Project:

balance = 1000
loop = True
I = {}

while loop == True:
    print("Pick a Role: ")
    print("a. Seller")
    print("b. Buyer")
    print("c. Exit")
    role = input("Input: ")

    if role == 'a':
        # seller stuff
        print("----[SELLER MENU]----")
        print("[INVENTORY]: ")
# line 17 to 18 is gemini
        total_stock = sum(info["stock"] for info in I.values())
        print("Total Stock:", total_stock)
        print("--------------------")
#line 21 to 24 is also gemini
        for name, info in I.items():
            print("Toy Name:", name)
            print("Price:", info["price"])
            print("Toy Stock:", info["stock"])
        print("--------------------")    
        print("Choices: ")
        print("a. Add/make a product")
        print("b. Exit")
        choice = input("Choose: ")
#I asked gemini what valueerror is
        if choice == 'a':
            print("----[TOY MAKER]----")
            tname = input("Enter a toy name: ")
            while True:
                try:
                    tprice = int(input("Enter price: "))
                    break
                except ValueError:
                    print("ERROR MUST INPUT A NUMBER")
            while True:
                try:
                    tstock = int(input("Enter quantity: "))
                    break
                except ValueError:
                    print("ERROR MUST INPUT A NUMBER")
            print("(OPTIONS)")
            print("a. done")
            print("b. stop")
            choice = input("Options: ")
            if choice == 'a':
                I[tname] = {"price": tprice, "stock": tstock} 
                print("[----Added", tname, "to inventory]----")
                continue
            elif choice == 'b':    
                break

    elif role == 'b':
        print("----[SHOP]----")
        print(f"Balance: ", balance)
        print("a. Buy Products")
        print("b. Return to Main Menu")
        choice = input("Input: ")
        if choice == 'a':
            print("Products from the seller bla bla bla")
        elif choice == 'b':
            break

    elif role == 'c':
        print("Code exited")
        break

    else:
        print("Invalid Input")
        continue



