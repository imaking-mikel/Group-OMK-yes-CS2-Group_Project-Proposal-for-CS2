Plushy Shop Project:

balance = 1000
loop = True
I = {}
toy = 0

while loop == True:
    print("Pick a Role: ")
    print("a. Seller")
    print("b. Buyer")
    print("c. Exit")
    role = input("Input: ")

    if role == 'a':
        print("----[SELLER MENU]----")
        print("[INVENTORY]: ")
        total_stock = sum(info["stock"] for info in I.values())
        print("Total Stock:", total_stock)
        print("--------------------")

        for name, info in I.items():
            print("Toy Name:", name)
            print("Price:", info["price"])
            print("Toy Stock:", info["stock"])
        print("--------------------")    
        print("Choices: ")
        print("a. Add/make a product")
        print("b. Exit to Main Menu")
        choice = input("Choose: ")

        if choice == 'a':
            print("----[TOY MAKER]----")
            tname = input("Enter a toy name: ")
            while True:
                try:
                    tprice = int(input("Enter price: "))
                    break
                except ValueError:
                    print("ERROR MUST INPUT A NUMBER")
            while True:
                try:
                    tstock = int(input("Enter quantity: "))
                    break
                except ValueError:
                    print("ERROR MUST INPUT A NUMBER")

            while True:
                print("(OPTIONS)")
                print("a. done")
                print("b. stop")
                choice = input("Options: ")
                if choice == 'a':
                    if tname in I:
                        I[tname]["price"] = tprice        
                        I[tname]["stock"] += tstock        
                        print("----[Updated stock and price for: ", tname, "]----")
                    else:
                        I[tname] = {"price": tprice, "stock": tstock} 
                        print("[----Added", tname, "to inventory]----")
                        toy += 1
                    break
                elif choice == 'b':    
                    break
                else:
                    print("Invalid option. Please choose 'a' or 'b'.")

        elif choice == 'b':
            continue  
        else:
            print("Invalid Choice!")

    elif role == 'b':
        print("----[SHOP]----")
        print("Balance:", balance)
        print("a. Buy Products")
        print("b. Return to Main Menu")
        choice = input("Input: ")

        if choice == 'a':
            total_stock = sum(info["stock"] for info in I.values())
            if total_stock == 0:
                print("Nothing in stock")
            else:
                print("\n----[AVAILABLE PRODUCTS]----")
                for name, info in I.items():
                    print("Toy Name:", name)
                    print("Price:", info["price"])
                    print("Stock:", info["stock"])
                    print("--------------------")

                buy = input("Enter the name of the toy to buy: ")

                if buy in I:
                    price = I[buy]["price"]
                    stock = I[buy]["stock"]

                    if stock <= 0:
                        print("Toy is out of stock")
                    elif balance < price:
                        print("Not enough balance to buy this toy")
                    else:
                        balance -= price
                        I[buy]["stock"] -= 1
                        print(f"Successfully bought {buy} for ${price}")
                        print(f"Remaining Balance: ${balance}")
                else:
                    print("Toy not found in shop")

        elif choice == 'b':
            continue  
        else:
            print("Invalid input")

    elif role == 'c':
        print("Code exited")
        break

    else:
        print("Invalid Input")
        continue



