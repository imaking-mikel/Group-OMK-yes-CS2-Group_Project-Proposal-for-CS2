Plushy Shop Project:

from colorama import init, Fore
init(autoreset=True)

balance = 1000
loop = True
I = {}
toy = 0

while loop == True:
    print("\033[H\033[J", end="")
    print("Pick a Role: ")
    print("a. Seller")
    print("b. Buyer")
    print("c. Exit")
    role = input("Input: ")

    if role == 'a':
        print("\033[H\033[J", end="")
        print("----[SELLER MENU]----")
        print("[INVENTORY]: ")
        total_stock = sum(info["stock"] for info in I.values())
        print("Total Stock:", total_stock)
        print("--------------------")

        for name, info in I.items():
            print("Toy Name:", name)
            print("Price:", info["price"])
            print("Toy Stock:", info["stock"])
        print("--------------------")
        print("Choices: ")
        print("a. Add/make a product")
        print("b. Exit to Main Menu")
        choice = input("Choose: ")

        if choice == 'a':
            print("\033[H\033[J", end="")
            print("----[TOY MAKER]----")
            tname = input("Enter a toy name: ")
            while True:
                try:
                    tprice = int(input("Enter price: "))
                    break
                except ValueError:
                    print(Fore.RED + "ERROR MUST INPUT A NUMBER")
            while True:
                try:
                    tstock = int(input("Enter quantity: "))
                    break
                except ValueError:
                    print(Fore.RED + "ERROR MUST INPUT A NUMBER")

            while True:
                print("\n(OPTIONS)")
                print("a. Save and return to menu")
                print("b. Cancel / Exit")
                choice = input("Options: ")
                if choice == 'a':
                    print("\033[H\033[J", end="")
                    if tname in I:
                        I[tname]["price"] = tprice
                        I[tname]["stock"] += tstock
                        print(f"----[Updated stock and price for: {tname}]----")
                    else:
                        I[tname] = {"price": tprice, "stock": tstock}
                        print(f"[----Added {tname} to inventory----]")
                        toy += 1
                    enter = input("Hit Enter to Continue")
                    break
                elif choice == 'b':
                    break
                else:
                    print(Fore.RED + "Invalid option. Please choose 'a' or 'b'.")

        elif choice == 'b':
            continue
        else:
            print(Fore.RED + "Invalid Choice!")
            enter = input("Hit Enter to Continue")

    elif role == 'b':
        print("\033[H\033[J", end="")
        print("----[SHOP]----")
        print("Balance:", balance)
        print("a. Buy Products")
        print("b. Return to Main Menu")
        choice = input("Input: ")

        if choice == 'a':
            print("\033[H\033[J", end="")
            total_stock = sum(info["stock"] for info in I.values())
            if total_stock == 0:
                print(Fore.RED + "Nothing in stock")
                enter = input("Hit Enter to Continue")
            else:
                print("----[AVAILABLE PRODUCTS]----")
                for name, info in I.items():
                    print("Toy Name:", name)
                    print("Price:", info["price"])
                    print("Stock:", info["stock"])
                    print("--------------------")

                buy = input("Enter the name of the toy to buy: ")

                if buy in I:
                    price = I[buy]["price"]
                    stock = I[buy]["stock"]

                    if stock <= 0:
                        print(Fore.RED + "Toy is out of stock")
                        enter = input("Hit Enter to Continue")
                    elif balance < price:
                        print(Fore.RED + "Not enough balance to buy this toy")
                        enter = input("Hit Enter to Continue")
                    else:
                        print("\033[H\033[J", end="")
                        balance -= price
                        I[buy]["stock"] -= 1
                        print(f"Successfully bought {buy} for ${price}")
                        print(f"Remaining Balance: ${balance}")
                        enter = input("Hit Enter to Continue")
                else:
                    print(Fore.RED + "Toy not found in shop")
                    enter = input("Hit Enter to Continue")

        elif choice == 'b':
            continue
        else:
            print(Fore.RED + "Invalid input")
            enter = input("Hit Enter to Continue")

    elif role == 'c':
        print("\033[H\033[J", end="")
        print(Fore.YELLOW + "\n                  Goodbye!")
        break

    else:
        print(Fore.RED + "Invalid Input")
        enter = input("Hit Enter to Continue")
        continue
